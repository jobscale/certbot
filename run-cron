#!/usr/bin/env bash
set -eu

export PATH=$PATH:/usr/local/bin:$HOME/bin:$HOME/.local/bin

docker-standard() {
  echo "$(TZ=Asia/Tokyo date -Iseconds) === [ Docker standard ] ==="
  docker ps | grep tls-nodejs
  cd /home/docker/partner/certs \
  && rm -fr README jsx.jp && unzip ../tls.zip && sudo chmod -R go+rX .
  docker restart tls-nodejs
}

kubernetes() {
  echo "$(TZ=Asia/Tokyo date -Iseconds) === [ Kubernetes ] ==="
  cd $HOME/_/cloud/k8s/
  . configure
  updateTLSSecret
}

run-cron() {
  LOG_DIR="$(dirname $0)/logs"
  LOG_FILE="$LOG_DIR/cron-certificate_$(date -Iseconds).log"
  mkdir -p $LOG_DIR
  {
    echo "$(TZ=Asia/Tokyo date -Iseconds) === [ Let's Encrypt ] ==="
    cd /home/docker/certbot
    bash run-docker
    FILE=$(find /tmp/root-tls | sort | tail -1)
    ls -l $FILE
    cp $FILE /home/docker/partner/tls.zip

    docker-standard || kubernetes
    echo
  } 2>&1 | tee -a $LOG_FILE

  exit
}

main() {
  run-cron
}

main
